# Copy to .env.local and fill in. .env*.local is gitignored — never commit real keys.

# --- Supabase (Phase 0 / 2) -------------------------------------------------
# Project settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS entirely — must never be referenced from a
# "use client" file or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# This app's own URL, no trailing slash. Used to build the Google OAuth
# redirect (src/app/auth/callback). Must also be added as an authorised
# redirect URI in the Google Cloud OAuth client — see BUILD_PLAN section 0.3.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiveKit (Phase 4) ------------------------------------------------------
# LiveKit Cloud project dashboard. The URL is public (the browser dials it);
# the key and secret are server-only and mint join tokens.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Chatbot (Phase 5) ------------------------------------------------------
# Groq by default. Any OpenAI-compatible provider works by changing the base
# URL and model — no code change needed.
GROQ_API_KEY=
CHAT_API_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=llama-3.3-70b-versatile
# Chat logging is no longer a flag. Every exchange is written to chat_logs,
# because the assistant's rate limits are counted from those rows — a switch
# that silently disabled abuse protection would be a trap. Retention is 12
# months, set in supabase/migrations/0006_maintenance.sql, and the privacy
# policy says so. Change one and you must change the other.

# --- Payments (Phase 3) -----------------------------------------------------
# PhonePe needs a registered merchant account (GST / business PAN) before it
# will issue credentials. Until then set PAYMENT_PROVIDER=mock to walk the
# whole checkout flow locally — it redirects straight back and reports every
# order as paid. It refuses to run in production unless ALLOW_MOCK_PAYMENTS=1.
PAYMENT_PROVIDER=mock
# Leave as sandbox until you have tested against PhonePe's UAT credentials.
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Set these to match the callback credentials configured in the PhonePe
# dashboard — the webhook is authenticated against them.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- Scheduled jobs ---------------------------------------------------------
# Protects /api/cron/*. Generate one with: openssl rand -hex 32
# The class-reminder job refuses to run without this, so it must be set before
# reminders will send. Vercel Cron sends it as a Bearer token automatically;
# any other scheduler (pg_cron + pg_net, GitHub Actions, cron-job.org) needs
# the same Authorization header. Run it every 5 minutes.
CRON_SECRET=

# --- Self-assessment emails (Phase 5.5) -------------------------------------
# Resend's free tier (3,000/month) covers MVP volume. Without this set, the
# self-assessment still scores, saves the lead and shows a WhatsApp link and
# a downloadable PDF — it just skips the email step rather than failing.
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend. The default only
# works for testing against your own Resend account's email.
RESEND_FROM_EMAIL=Mass Fitness <onboarding@resend.dev>
